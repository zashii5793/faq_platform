# === A株式会社 専用テナント設定 ===
#
# ⚠ ANTHROPIC_API_KEY / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET は
#    A社サーバーに配置する直前にインストール担当（提供側）が埋めること。
#    リポジトリにはコミットしない（実値は ~/.inquira_provider_secrets から）。
#
PRODUCT_NAME=Inquira
ORG_NAME=A株式会社
ASSISTANT_ROLE=社内ヘルプデスク

# --- Anthropic (提供側持ち) ---
ANTHROPIC_API_KEY=__FILL_FROM_PROVIDER_SECRETS__
CLAUDE_MODEL=claude-sonnet-4-6

# --- Google OAuth (提供側持ち) ---
GOOGLE_CLIENT_ID=__FILL_FROM_PROVIDER_SECRETS__
GOOGLE_CLIENT_SECRET=__FILL_FROM_PROVIDER_SECRETS__
GOOGLE_REDIRECT_URI=https://faq.a-corp.jp/auth/callback

# --- アクセス制御 ---
# ALLOWED_DOMAIN: 一般社員にも開放する場合は A社の Gmail ドメインを設定 (例: a-corp.jp)
# 空のままだと ALLOWED_EMAILS に列挙された人だけがアクセス可
#
# ALLOWED_EMAILS: 管理者の Gmail をカンマ区切りで列挙
# ⚠ このテンプレートには実メールアドレスを書かない (リポジトリ公開のため)。
#    インストール時にローカルの .env (.gitignore 対象) を作成し、そちらに実値を書く。
ALLOWED_DOMAIN=
ALLOWED_EMAILS=__FILL_ADMIN_GMAILS_COMMA_SEPARATED__

# --- セッション (install.sh が起動時に上書き) ---
SESSION_SECRET=__GENERATED_BY_INSTALL_SH__

DEMO_MODE=false
HOST=0.0.0.0
PORT=8000

# --- データ保存先 (install スクリプトが __DATA_DIR__ を置換) ---
# デフォルト: __APP_DIR__/data (Linux: /opt/inquira/data, Windows: %USERPROFILE%/Inquira/data)
# UNC 指定可 (ネットワーク共有): install.ps1 -DataDir "\\<fileserver>\<share>\<path>"
# forward-slash 形式で書かれます (Python pathlib は Windows でも forward-slash を受け付け)
FAQ_MASTER_DIR=__DATA_DIR__/faq_master
INDEX_PATH=__DATA_DIR__/index.json
AUDIT_LOG_DIR=__DATA_DIR__/audit
FEEDBACK_PATH=__DATA_DIR__/feedback_scores.json
ORG_SETTINGS_PATH=__DATA_DIR__/org_settings.json
RAW_UPLOAD_DIR=__DATA_DIR__/raw
SHARED_QA_META_PATH=__DATA_DIR__/shared_qa_meta.json
FAQ_CANDIDATES_PATH=__DATA_DIR__/faq_candidates.json
FAQ_CANDIDATE_SETTINGS_PATH=__DATA_DIR__/faq_candidate_settings.json
IMPACT_SETTINGS_PATH=__DATA_DIR__/impact_settings.json
EMBEDDING_CACHE_PATH=__DATA_DIR__/embeddings.npz
