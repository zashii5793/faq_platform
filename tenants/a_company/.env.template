# === A株式会社 専用テナント設定 ===
#
# ⚠ ANTHROPIC_API_KEY / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET は
#    A社サーバーに配置する直前にインストール担当（提供側）が埋めること。
#    リポジトリにはコミットしない（実値は ~/.inquira_provider_secrets から）。
#
PRODUCT_NAME=Inquira
ORG_NAME=A株式会社
ASSISTANT_ROLE=社内ヘルプデスク

# --- Anthropic (提供側持ち) ---
ANTHROPIC_API_KEY=__FILL_FROM_PROVIDER_SECRETS__
CLAUDE_MODEL=claude-sonnet-4-6

# --- Google OAuth (提供側持ち) ---
GOOGLE_CLIENT_ID=__FILL_FROM_PROVIDER_SECRETS__
GOOGLE_CLIENT_SECRET=__FILL_FROM_PROVIDER_SECRETS__
GOOGLE_REDIRECT_URI=https://faq.a-corp.jp/auth/callback

# --- アクセス制御 ---
# ALLOWED_DOMAIN: 一般社員にも開放する場合は A社の Gmail ドメインを設定 (例: a-corp.jp)
# 空のままだと ALLOWED_EMAILS に列挙された人だけがアクセス可
#
# ALLOWED_EMAILS: 管理者の Gmail をカンマ区切りで列挙
# ⚠ このテンプレートには実メールアドレスを書かない (リポジトリ公開のため)。
#    インストール時にローカルの .env (.gitignore 対象) を作成し、そちらに実値を書く。
ALLOWED_DOMAIN=
ALLOWED_EMAILS=__FILL_ADMIN_GMAILS_COMMA_SEPARATED__

# --- セッション (install.sh が起動時に上書き) ---
SESSION_SECRET=__GENERATED_BY_INSTALL_SH__

DEMO_MODE=false
HOST=0.0.0.0
PORT=8000

# --- データ保存先 (A社サーバー内のローカルディスク) ---
# Linux: /opt/inquira/data/* / Windows: C:/Inquira/data/* (install スクリプトが書き換える)
FAQ_MASTER_DIR=__APP_DIR__/data/faq_master
INDEX_PATH=__APP_DIR__/data/index.json
AUDIT_LOG_DIR=__APP_DIR__/data/audit
FEEDBACK_PATH=__APP_DIR__/data/feedback_scores.json
ORG_SETTINGS_PATH=__APP_DIR__/data/org_settings.json
RAW_UPLOAD_DIR=__APP_DIR__/data/raw
SHARED_QA_META_PATH=__APP_DIR__/data/shared_qa_meta.json
FAQ_CANDIDATES_PATH=__APP_DIR__/data/faq_candidates.json
FAQ_CANDIDATE_SETTINGS_PATH=__APP_DIR__/data/faq_candidate_settings.json
IMPACT_SETTINGS_PATH=__APP_DIR__/data/impact_settings.json
EMBEDDING_CACHE_PATH=__APP_DIR__/data/embeddings.npz
