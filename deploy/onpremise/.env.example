# =====================================================
# Inquira 自社サーバー導入用 設定テンプレート
# cp .env.example .env して埋める
# =====================================================

# --- ホスト名 ---
# Inquira にアクセスする URL（HTTPS）。Caddy が Let's Encrypt で証明書を自動取得。
# DNS の A レコードでこのホストをサーバーの IP に向けておくこと。
CLIENT_HOST=a-company.inquira.app
ACME_EMAIL=ops@inquira.app

# --- 表示名 ---
ORG_NAME=A社
ASSISTANT_ROLE=社内ヘルプデスク

# --- データ保管先（クライアントサーバー内のパス）---
# 一般スタッフ・Inquira 運営はここに直接アクセスできない。
# 情シス（サーバー管理者）のみ閲覧・バックアップ可能。
DATA_DIR=/srv/inquira/data

# --- Anthropic API ---
# 運用方針は docs/billing_design.md 参照。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# --- Google OAuth ---
# OAuth クライアントの「承認済みのリダイレクト URI」に
# https://${CLIENT_HOST}/auth/callback を追加しておく。
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# 許可ドメイン or 明示メール（どちらか必須）
ALLOWED_DOMAIN=a-company.co.jp
ALLOWED_EMAILS=

# --- セッション ---
# 48 文字以上のランダム文字列を必ず新規生成して入れる
# 生成例: openssl rand -hex 32
SESSION_SECRET=REPLACE_ME_WITH_RANDOM_48CHARS

# --- マスキング ---
# general | education | healthcare | finance
MASKING_INDUSTRY=general

# --- 検索バックエンド ---
# tfidf / e5-small / e5-base / e5-large
EMBEDDING_BACKEND=tfidf

# --- アップロード上限 (MB) ---
MAX_UPLOAD_MB=1024

# --- イメージ ---
# CI でビルド済みのタグを指定。本番では :latest ではなく :vX.Y.Z で固定推奨。
INQUIRA_IMAGE=ghcr.io/zashii5793/inquira:latest
