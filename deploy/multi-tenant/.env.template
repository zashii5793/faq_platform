# =====================================================
# Inquira クライアント設定テンプレート
# =====================================================
# 新規クライアント追加時、このファイルをコピーして埋める。
#   cp .env.template clients/<slug>/.env
# =====================================================

# --- クライアント識別 ---
# サブドメインに使う slug（英小文字・数字・ハイフン）
CLIENT_SLUG=a-company
# 表示名（チャット画面・OG タグなどで使用）
ORG_NAME=A社
# AI の役割（任意）
ASSISTANT_ROLE=社内ヘルプデスク

# --- ホスティング ドメイン ---
# 全テナント共通のルートドメイン（弊社管理）
ROOT_DOMAIN=inquira.app
# → 実際のホスト名は ${CLIENT_SLUG}.${ROOT_DOMAIN} になる

# --- データ保管先（ホスト側パス） ---
# クライアントごとに独立。バックアップ対象もこのパス。
DATA_DIR=/srv/inquira/clients/a-company/data

# --- Anthropic API ---
# 弊社マスターキーをそのまま入れるか、クライアント専用に発行した子キーを入れる。
# 詳細は docs/billing_design.md 参照。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# --- Google OAuth ---
# 弊社共通の OAuth クライアントを使い、Redirect URI に
# https://${CLIENT_SLUG}.${ROOT_DOMAIN}/auth/callback を事前登録しておく。
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# 許可ドメイン or 明示メール（どちらか必須）
ALLOWED_DOMAIN=a-company.co.jp
ALLOWED_EMAILS=

# --- セッション ---
# クライアントごとに必ず別の値（48文字以上推奨）
SESSION_SECRET=REPLACE_ME_WITH_RANDOM_48CHARS

# --- マスキング ---
# general | education | healthcare | finance
MASKING_INDUSTRY=general

# --- 検索バックエンド ---
# tfidf / e5-small / e5-base / e5-large
EMBEDDING_BACKEND=tfidf

# --- アップロード上限 (MB) ---
MAX_UPLOAD_MB=1024

# --- イメージ ---
# CI でビルド → GHCR push 済みのタグを指定。
INQUIRA_IMAGE=ghcr.io/zashii5793/inquira:latest
