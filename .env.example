# --- プロダクト識別 ---
PRODUCT_NAME=Inquira
ORG_NAME=○○株式会社
ASSISTANT_ROLE=社内ヘルプデスク

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# --- Google OAuth ---
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# 許可する Google ドメイン（例: example.com）または明示メール（カンマ区切り）
ALLOWED_DOMAIN=
ALLOWED_EMAILS=

# --- セッション ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- データ保存先（全てローカルファイルシステム） ---
# 詳細とバックアップ方針 → docs/data_storage_guide.md

# FAQ マスター（取り込み済みドキュメントの整形済みコピー）
FAQ_MASTER_DIR=./data/faq_master
# 検索インデックス（TF-IDF・チャンクメタデータ）
INDEX_PATH=./data/index.json
# 監査ログ（質問履歴・操作履歴 / 日次ローテーション）
AUDIT_LOG_DIR=./data/audit
# 👍/👎 フィードバック学習スコア
FEEDBACK_PATH=./data/feedback_scores.json
# 組織情報（管理画面で編集した値の永続化）
ORG_SETTINGS_PATH=./data/org_settings.json
# アップロードされた生ファイル（取り込み前の原本）
RAW_UPLOAD_DIR=./data/raw
# Embedding キャッシュ（embedding バックエンド使用時のみ）
EMBEDDING_CACHE_PATH=./data/embeddings.npz

# --- マスキング ---
# general | education | healthcare | finance
MASKING_INDUSTRY=general

# --- 検索バックエンド ---
# tfidf  : デフォルト・軽量・モデルDL不要
# e5-small : 初回 470MB DL、精度向上、メモリ 1〜2GB
# e5-base  : 初回 1.1GB DL、e5-large に近い精度
# e5-large : 初回 2.2GB DL、最高精度、メモリ 4〜6GB
EMBEDDING_BACKEND=tfidf

# --- サーバー ---
HOST=0.0.0.0
PORT=8000

# --- 開発用 ---
# 認証バイパス＋APIキー無しでも動作（本番では絶対 false）
DEMO_MODE=false
