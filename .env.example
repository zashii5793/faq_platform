# --- プロダクト識別 ---
PRODUCT_NAME=Inquira
ORG_NAME=○○株式会社
ASSISTANT_ROLE=社内ヘルプデスク

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# --- Google OAuth ---
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# 許可する Google ドメイン（例: example.com）または明示メール（カンマ区切り）
ALLOWED_DOMAIN=
ALLOWED_EMAILS=

# --- セッション ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- データ ---
FAQ_MASTER_DIR=./data/faq_master
INDEX_PATH=./data/index.json

# --- マスキング ---
# general | education | healthcare | finance
MASKING_INDUSTRY=general

# --- サーバー ---
HOST=0.0.0.0
PORT=8000

# --- 開発用 ---
# 認証バイパス＋APIキー無しでも動作（本番では絶対 false）
DEMO_MODE=false
